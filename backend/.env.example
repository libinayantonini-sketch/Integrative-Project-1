# Copie este arquivo para backend/.env e ajuste os valores.
# O .env NÃO vai para o GitHub (tem a senha do seu MySQL).

# usuário:senha do SEU MySQL. Mantenha o nome do banco: projeto_sinalizacoes
DB_URL=mysql+pymysql://root:SUA_SENHA@localhost:3306/projeto_sinalizacoes

# Endereço da API (e do front): http://127.0.0.1:8000
HOST=127.0.0.1
PORTA=8000

# Pastas (relativas à pasta backend/)
STORAGE_DIR=storage
MODELO_PESOS=modelos/detector_v1.pt
FRONTEND_DIR=../frontend

# Processamento: 1 frame guardado no banco a cada X segundos de vídeo
INTERVALO_EXTRACAO_S=1
QUALIDADE_JPEG=90
# Vazio = automático (usa GPU NVIDIA se existir). Ou: cpu
DISPOSITIVO=

# Regras de envio de vídeo (as mesmas do front)
VIDEO_MIN_S=10
VIDEO_MAX_S=40
TAM_MAX_MB=200